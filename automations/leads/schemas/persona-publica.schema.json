{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patagon.ai/schemas/persona-publica.schema.json",
  "title": "Persona pública para prospecção Patagon AI",
  "description": "Schema para registrar somente dados profissionais públicos e evidências usadas na priorização de uma pessoa.",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "employment", "role_fit", "sources", "status_persona"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name"],
      "properties": {
        "full_name": {"type": "string"},
        "linkedin_url": {"type": ["string", "null"], "format": "uri"},
        "instagram_url": {"type": ["string", "null"], "format": "uri"},
        "public_profile_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "employment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "title_exact", "current_employment_confirmed", "title_exact_found"],
      "properties": {
        "company": {"type": "string"},
        "dealer_group": {"type": ["string", "null"]},
        "brand_or_business_unit": {"type": ["string", "null"]},
        "unit_or_region": {"type": ["string", "null"]},
        "title_exact": {"type": "string"},
        "normalized_area": {"type": ["string", "null"]},
        "seniority": {"type": ["string", "null"], "enum": ["owner", "c_level", "vp", "director", "head", "manager", "coordinator", "lead", "individual_contributor", "unknown", null]},
        "current_employment_confirmed": {"type": "string", "enum": ["sim", "nao", "nao_verificado"]},
        "title_exact_found": {"type": "string", "enum": ["sim", "nao", "nao_verificado"]},
        "time_in_role_months": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "role_fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment", "eligible_area", "role_estimated", "role_confidence"],
      "properties": {
        "segment": {"type": "string", "enum": ["automotive", "saas_platform"]},
        "eligible_area": {"type": "string", "enum": ["sim", "nao", "nao_verificado"]},
        "role_estimated": {"type": "string", "enum": ["decision_maker", "champion", "user_influencer", "non_priority", "unknown"]},
        "role_confidence": {"type": "string", "enum": ["alta", "media", "baixa"]},
        "scope_evidence": {"type": ["string", "null"]},
        "hypothesized_kpis": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "patagon_relevance_hypothesis": {"type": ["string", "null"]}
      }
    },
    "public_activity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "relevant_topics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "recent_role_change": {"type": "string", "enum": ["sim", "nao", "nao_verificado"]},
        "public_statement_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "url", "answers", "observed_at", "confidence"],
        "properties": {
          "source_type": {"type": "string", "enum": ["linkedin", "instagram", "google", "company_site", "press", "event", "association", "other"]},
          "url": {"type": "string", "format": "uri"},
          "answers": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "observed_at": {"type": "string", "format": "date"},
          "confidence": {"type": "string", "enum": ["alta", "media", "baixa"]},
          "note": {"type": ["string", "null"]}
        }
      }
    },
    "status_persona": {"type": "string", "enum": ["T1", "T2", "T3", "nao_prioritaria", "desatualizada"]},
    "next_action": {"type": ["string", "null"]}
  }
}
