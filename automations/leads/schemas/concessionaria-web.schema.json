{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patagon.ai/schemas/concessionaria-web.schema.json",
  "title": "Registro público de concessionária automotiva",
  "description": "Schema para normalizar evidências públicas encontradas em sites de montadoras, grupos, unidades e páginas comerciais.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "brand", "unit", "commercial_signals", "evidence"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "source_type", "observed_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "source_type": {"type": "string", "enum": ["brand_locator", "brand_site", "dealer_group_site", "unit_site", "google_maps", "google_business", "instagram", "landing_page", "other"]},
        "observed_at": {"type": "string", "format": "date"}
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "alias_found": {"type": ["string", "null"]},
        "official_site": {"type": ["string", "null"], "format": "uri"},
        "locator_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "dealer_group": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": ["string", "null"]},
        "legal_name": {"type": ["string", "null"]},
        "website": {"type": ["string", "null"], "format": "uri"},
        "instagram_url": {"type": ["string", "null"], "format": "uri"},
        "linkedin_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "city", "state", "unit_type", "authorized_status"],
      "properties": {
        "name": {"type": "string"},
        "legal_name": {"type": ["string", "null"]},
        "city": {"type": "string"},
        "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "address": {"type": ["string", "null"]},
        "postal_code": {"type": ["string", "null"]},
        "phone": {"type": ["string", "null"]},
        "website": {"type": ["string", "null"], "format": "uri"},
        "google_maps_url": {"type": ["string", "null"], "format": "uri"},
        "unit_type": {"type": "string", "enum": ["sales", "sales_and_service", "service_only", "parts_only", "used_cars", "mall_store", "unknown"]},
        "authorized_status": {"type": "string", "enum": ["sim", "nao", "nao_verificado"]},
        "counts_as_commercial_unit": {"type": "boolean"},
        "dedupe_key": {"type": ["string", "null"], "description": "brand_id|group_normalized|city|address_normalized"}
      }
    },
    "commercial_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["whatsapp_public", "lead_form_public", "offers_public", "test_drive_public"],
      "properties": {
        "whatsapp_public": {"type": "string", "enum": ["sim", "nao_verificado"]},
        "whatsapp_numbers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "whatsapp_context": {"type": "array", "items": {"type": "string", "enum": ["sales", "offer", "test_drive", "direct_sales", "general_contact", "service", "unknown"]}, "uniqueItems": true},
        "lead_form_public": {"type": "string", "enum": ["sim", "nao_verificado"]},
        "offers_public": {"type": "string", "enum": ["sim", "nao_verificado"]},
        "test_drive_public": {"type": "string", "enum": ["sim", "nao_verificado"]},
        "offers_url": {"type": ["string", "null"], "format": "uri"},
        "test_drive_url": {"type": ["string", "null"], "format": "uri"},
        "landing_page_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true}
      }
    },
    "persona_discovery_sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linkedin_company_url": {"type": ["string", "null"], "format": "uri"},
        "instagram_company_url": {"type": ["string", "null"], "format": "uri"},
        "about_team_url": {"type": ["string", "null"], "format": "uri"},
        "press_urls": {"type": "array", "items": {"type": "string", "format": "uri"}, "uniqueItems": true}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "value", "source_url", "observed_at", "confidence"],
        "properties": {
          "criterion": {"type": "string"},
          "value": {"type": ["string", "number", "boolean", "null"]},
          "source_url": {"type": "string", "format": "uri"},
          "observed_at": {"type": "string", "format": "date"},
          "confidence": {"type": "string", "enum": ["alta", "media", "baixa"]},
          "note": {"type": ["string", "null"]}
        }
      }
    }
  }
}
