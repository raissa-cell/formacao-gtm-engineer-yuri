  "purpose": "Encontrar e priorizar pessoas públicas nas contas aderentes ao ICP da Patagon AI.",
  "states": ["sim", "nao", "nao_verificado", "nao_aplicavel"],
  "source_questions": {
    "linkedin": {
      "answers": ["quem ocupa o cargo", "empresa atual", "senioridade", "tempo aproximado no cargo", "atividade profissional pública"],
      "strength": "alta_para_vinculo_e_cargo",
      "caution": "perfil pode estar desatualizado"
    },
    "instagram": {
      "answers": ["quem aparece ligado à operação", "proprietários e gestores locais", "eventos", "inaugurações", "marcações da empresa"],
      "strength": "alta_para_descoberta_automotiva",
      "caution": "cargo e vínculo exigem bio profissional, publicação institucional ou segunda fonte"
    },
    "google": {
      "answers": ["nomeações", "entrevistas", "eventos", "premiações", "menções do cargo", "fala pública sobre problemas"],
      "strength": "media_a_alta_conforme_fonte",
      "caution": "conferir data e origem da publicação"
    },
    "company_site": {
      "answers": ["liderança oficial", "vínculo", "escopo", "unidade ou região", "canais públicos"],
      "strength": "alta",
      "caution": "páginas institucionais podem não ser atualizadas rapidamente"
    },
    "press_events_associations": {
      "answers": ["vínculo e cargo em data específica", "responsabilidade declarada", "expansão", "tema de interesse"],
      "strength": "alta_quando_datada_e_oficial",
      "caution": "não assumir que o cargo continua atual sem confirmação"
    },
    "reddit_reviews_comments": {
      "answers": ["como o mercado descreve a dor", "objeções", "linguagem usada em voz alta"],
      "strength": "pesquisa_de_mercado",
      "caution": "não usar para atribuir dor, opinião ou intenção de compra a uma pessoa específica"
    },
    "competitors_customers": {
      "answers": ["categoria de solução comprada", "casos de uso", "alternativas consideradas"],
      "strength": "pesquisa_de_categoria",
      "caution": "não prova compra, intenção ou prioridade da pessoa pesquisada"
    }
  },
  "qualification_rules": {
