# Copie para .env (cp .env.example .env) e preencha. NUNCA suba o .env.

# Upload-Post (publicação LinkedIn/Instagram/X) https://upload-post.com
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# Apify (raspagem de comentários/reações/perfis) https://console.apify.com
APIFY_API_KEY=

# Nuvia (CRM + campanhas). Usado pelos scripts via REST; o MCP usa OAuth no Claude Code
NUVIA_API_KEY=

# ClickUp (opcional: curadoria e board de conteúdo)
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_FIELD_POST_REFERENCIA=
CLICKUP_FIELD_LINK_REFERENCIA=
